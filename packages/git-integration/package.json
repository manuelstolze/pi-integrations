{
  "name": "@manuelstolze/pi-git-integration",
  "version": "1.1.1",
  "description": "Pi extension for guided Git commits, pushes, and GitHub or GitLab review requests.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "git",
    "github",
    "gitlab"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.3.0 <2",
    "@earendil-works/pi-coding-agent": ">=1.3.0 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/manuelstolze/pi-integrations",
    "directory": "packages/git-integration"
  }
}
